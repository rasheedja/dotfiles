# Start antigen
source ~/.antigen.zsh

# Load the oh-my-zsh's library.
antigen use oh-my-zsh

# Load bundles 
antigen bundle command-not-found
antigen bundle common-aliases 
antigen bundle cp
antigen bundle direnv
antigen bundle git
antigen bundle node
antigen bundle npm
antigen bundle nvm
antigen bundle pip
antigen bundle python
antigen bundle rsync
antigen bundle tmux
antigen bundle virtualenv
antigen bundle yarn

antigen bundle zsh-users/zsh-autosuggestions
antigen bundle zsh-users/zsh-completions
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle zsh-users/zsh-history-substring-search

# Load the theme.
# antigen theme https://github.com/caiogondim/bullet-train-oh-my-zsh-theme bullet-train
antigen theme robbyrussell

BULLETTRAIN_PROMPT_ORDER=(
  time
  status
  custom
  dir
  git
  cmd_exec_time
)

# Finish antigen
antigen apply

# Specify default shell
SHELL=$(which zsh)

# Aliases
alias vimrc="vim ~/.vimrc"
alias zshrc="vim ~/.zshrc"
alias e="emacsclient -t -a ''"
alias eg="emacsclient -c -a ''"

# Pi sandbox: pi runs in a container, so the host is only reachable through
# the mounts pi-sbx declares. `sbx` is the normal sandbox, which can read AWS;
# `sbx aws` additionally lets AWS changes run without asking, for deploys and
# teardowns. Everything else is the same in both.
alias sbx="$HOME/Documents/personal/git/dotfiles/pi/sandbox/pi-sbx"

# pi-background-tasks registers shell jobs, a delegated agent, multi-model
# Fusion, attested runs and Anthropic attribution, all on by default. Only the
# shell jobs and Fusion add anything over @gotgenes/pi-subagents, which already
# owns delegation -- keeping `delegate` here would register a second way to
# spawn a child agent, for the same read-only investigation it already does.
# `process` is mandatory in the set, so it cannot be dropped. This is the only
# lever the package offers: it reads the variable at each extension activation,
# including a real /reload.
export PI_BG_FEATURES="process,fusion,attested,attribution"

# Editor
export VISUAL="emacsclient -t -a ''"
export EDITOR="$VISUAL"

# Export TERM only if NOT inside tmux
if [[ -z "$TMUX" ]]; then
    export TERM="xterm-256color"
fi

# Add home opt to path
path+=("$HOME/opt")

# Add GPS to path
path+=("$HOME/Research/opt/GNAT/2018/bin")

# Add Isabelle to path
path+=("$HOME/Research/opt/Isabelle2018/bin")

# Add local bin
path+=("$HOME/.local/bin")

# Add ghcup to path
path+=("$HOME/.ghcup/bin")

# Add cabal bin to path
path+=("$HOME/.cabal/bin")

# Add aiken to path
path+=("$HOME/.aiken/bin")

# direnv hook
eval "$(direnv hook zsh)"

# brew nvm
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# dynamic completions
source <(COMPLETE=zsh jj)

# rust
. "$HOME/.cargo/env"

# bun completions
[ -s "/Users/junaid/.bun/_bun" ] && source "/Users/junaid/.bun/_bun"
